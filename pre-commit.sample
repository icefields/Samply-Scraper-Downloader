#!/bin/bash
# Pre-commit hook to block sensitive files
# Install: cp pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Check for .env files (but allow .env.samply-example, .env-example, etc.)
if git diff --cached --name-only | grep -qE '^[^/]*\.env$|/\.env$'; then
    echo ""
    echo "❌ BLOCKED: .env file detected in commit"
    echo "   .env files may contain personal info and should not be committed"
    echo "   Use .env-example or .env.samply-example with placeholders instead"
    echo ""
    exit 1
fi

# Allow .env.samply-example, .env-example, etc. (example files)
# Block actual config files like .env.samply, .env.local
if git diff --cached --name-only | grep -qE '\.env\.(samply|local|production|staging|dev)$'; then
    echo ""
    echo "❌ BLOCKED: Active .env.* config file detected"
    echo "   Only example files (.env-example, .env.samply-example) should be committed"
    echo ""
    exit 1
fi

# Check for state/config JSON files with potential URLs/IDs
if git diff --cached --name-only | grep -qE 'state\.json|config\.json|credentials|_state\.json'; then
    echo ""
    echo "❌ BLOCKED: Potential state/config file detected"
    echo "   JSON files may contain personal URLs and IDs"
    echo ""
    exit 1
fi

# Check for large files (>50MB)
LARGE_FILES=$(git diff --cached --name-only | xargs -I{} du -m {} 2>/dev/null | awk '$1 > 50 {print $2}')
if [ -n "$LARGE_FILES" ]; then
    echo ""
    echo "⚠️  WARNING: Large files detected (>50MB):"
    echo "$LARGE_FILES"
    echo "   Consider using Git LFS or excluding from repo"
    echo ""
fi

exit 0