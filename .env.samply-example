# Samply Tracker Configuration
# Copy this file to .env and customize for your project
# ================================================================

# Project URL from Samply share link
# Find this in your browser when viewing the project
SAMPLY_URL=https://samply.app/p/YOUR_SHARE_ID

# Project/Artist name (for display purposes)
SAMPLY_PROJECT_NAME=Your Project Name
SAMPLY_ARTIST=Your Artist Name

# Downloads directory (absolute path or use ~ for home)
# This is where audio files will be saved
SAMPLY_DOWNLOADS_DIR=~/Music/samply_downloads

# State file (tracks version history and project info)
# This file is auto-generated and updated by the scripts
SAMPLY_STATE_FILE=~/.config/samply/tracker_state.json

# Audio Quality Preferences
# =========================

# Prefer FLAC source when available (true/false)
# FLAC gives better quality but larger downloads
SAMPLY_PREFER_FLAC=true

# Output format: opus, mp3, or flac
# - opus: Best quality/size ratio, great for streaming
# - mp3: Universal compatibility
# - flac: Lossless, largest files
SAMPLY_OUTPUT_FORMAT=opus

# Bitrate for lossy formats (opus, mp3)
# Common values: 128k, 192k, 256k, 320k
SAMPLY_OUTPUT_BITRATE=192k

# Matrix Notifications (optional)
# ===============================
# Send notifications to a Matrix room when updates are found
# Leave empty to disable notifications
# Format: !room_id:homeserver.tld
SAMPLY_MATRIX_ROOM=

# Advanced Settings
# =================
# CDN base URL (usually auto-derived from user_id in state file)
# Override only if you know what you're doing
# SAMPLY_CDN_BASE=https://cdn.samply.app/users/{user_id}/files